{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/avatars/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|vrm)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "cdn-libs",
      "urls": [
        "https://cdn.jsdelivr.net/**",
        "https://unpkg.com/**",
        "https://storage.googleapis.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "30d",
        "maxSize": 1000
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.**",
    "!/**/*__/**"
  ]
}
